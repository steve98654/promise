---
import { driveFolder } from '../data/links';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Planning a Promise school in Newark, NJ, and beyond.' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/committee/', label: 'Committee' },
  { href: '/plan/', label: 'Plan' },
  { href: '/pitch/', label: 'Pitch' },
  { href: '/budget/', label: 'Budget' },
  { href: '/sites/', label: '23 Sites' },
  { href: '/documents/', label: 'Documents' },
  { href: '/brand/', label: 'Brand' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/brand/' && path.startsWith('/logos'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/we-promise-icon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand"><img src="/brand/we-promise-horizontal-dark.svg" alt="We Promise" height="52" /></a>
      <nav aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p><a href={driveFolder}>Shared Google Drive folder</a> · <a href="/documents/">All documents</a></p>
      <p>Planning draft. Not affiliated with or endorsed by the LeBron James Family Foundation.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --navy: #12233f;
    --gold: #f5b82e;
    --brick: #b23a2b;
    --cream: #fff7e8;
    --ink: #1c2433;
    --muted: #5b6475;
    --card: #ffffff;
    --border: #e7dcc6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    color: var(--ink);
    background: var(--cream);
    line-height: 1.55;
  }
  main { max-width: 1100px; margin: 0 auto; padding: 32px 16px 64px; }
  h1, h2, h3 { color: var(--navy); line-height: 1.2; }
  a { color: var(--brick); }
  .site-header {
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
    padding: 6px 16px; background: #041e42;
  }
  .site-header a { color: var(--cream); text-decoration: none; font-weight: 600; }
  .site-header .brand img { display: block; height: 52px; width: auto; }
  .site-header nav { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .site-header nav a { padding: 4px 0; border-bottom: 2px solid transparent; }
  .site-header nav a[aria-current='page'] { color: var(--gold); border-bottom-color: var(--gold); }
  .site-footer a { color: var(--muted); }

  /* Shared content styles for the planning pages */
  .page-intro { max-width: 760px; color: var(--muted); font-size: 1.08rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-weight: 700; font-size: 0.8rem; color: var(--brick); margin: 0; }
  .prose { max-width: 780px; }
  .prose li { margin: 4px 0; }
  section.block { margin-top: 44px; }
  section.block > h2 { border-bottom: 2px solid var(--gold); padding-bottom: 6px; }
  .callout {
    background: var(--navy); color: var(--cream); border-radius: 12px; padding: 16px 20px;
    font-weight: 600; max-width: 820px; margin: 18px 0;
  }
  .callout a { color: var(--gold); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; margin: 18px 0; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 16px 18px; }
  .card h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .card p { margin: 6px 0; }
  .card ul { margin: 6px 0; padding-left: 18px; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 14px; margin: 18px 0; }
  .stat { background: var(--card); border: 1px solid var(--border); border-left: 5px solid var(--gold); border-radius: 10px; padding: 12px 16px; }
  .stat .num { font-size: 1.6rem; font-weight: 800; color: var(--navy); line-height: 1.1; }
  .stat .lbl { color: var(--muted); font-size: 0.9rem; }
  .table-wrap { overflow-x: auto; margin: 14px 0; border: 1px solid var(--border); border-radius: 10px; background: var(--card); }
  table.data { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  table.data th, table.data td { padding: 8px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); }
  table.data thead th { background: var(--navy); color: var(--cream); position: sticky; top: 0; }
  table.data tbody tr:nth-child(even) td { background: #fbf6ec; }
  table.data td.num, table.data th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .small { font-size: 0.85rem; color: var(--muted); }
  .button {
    display: inline-block; padding: 10px 18px; border-radius: 8px; background: var(--navy);
    color: var(--cream); text-decoration: none; font-weight: 700;
  }
  .button.gold { background: var(--gold); color: var(--navy); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0; }
  .site-footer { text-align: center; color: var(--muted); font-size: 0.85rem; padding: 24px 16px 40px; }
</style>
