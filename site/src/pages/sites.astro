---
import Base from '../layouts/Base.astro';
import Draft from '../components/Draft.astro';
import sites from '../data/sites.json';
import { docs } from '../data/links';

type Site = (typeof sites)[number];
const num = (v: number | string) => (v === '' || v === null ? '–' : v);
const waveOf = (s: Site) => s.wave.replace(/ \(.*\)$/, '');
const waves = [
  { name: 'Wave 1', when: '2028-29 (placeholder)', why: "Highest need; Cleveland, Detroit, Flint and Gary sit within a day's drive of Akron for shared staff training." },
  { name: 'Wave 2', when: '2030-31 (placeholder)', why: 'High need; adds the Northeast and Gulf South.' },
  { name: 'Wave 3', when: '2032-33 (placeholder)', why: 'Completes national reach, including the strategic picks.' },
];

const alternates = [
  ['Baton Rouge, LA', '54%', '33%', '51.8', 'Third Louisiana city'],
  ['Mobile, AL', '52%', '34%', '50.4', 'Third Alabama city'],
  ['Camden, NJ', '41%', '45%', '50.1', 'New Jersey covered by Newark'],
  ['Cincinnati, OH', '41%', '35%', '48.4', 'Fourth Ohio city'],
  ['Dayton, OH', '38%', '40%', '46.7', 'Fourth Ohio city'],
  ['Savannah, GA', '51%', '32%', '45.5', 'Just below the cutoff'],
  ['Houston, TX', '22%', '29%', '42.2', 'Below cutoff citywide; strong option for a Texas presence (Fifth Ward, Sunnyside)'],
  ['Richmond, VA', '44%', '30%', '41.8', 'Just below the cutoff'],
  ['Toledo, OH', '27%', '37%', '40.1', 'Fourth Ohio city'],
  ['Washington, DC', '43%', '22%', '39.3', 'Citywide numbers dilute Wards 7 and 8, where need is very high'],
  ['Little Rock, AR', '41%', '26%', '34.1', 'Below cutoff'],
  ['Kansas City, MO', '27%', '23%', '27.4', 'Below cutoff'],
  ['Oakland, CA', '21%', '18%', '15.4', 'Below cutoff'],
];
---

<Base title="23 sites · We Promise" description="The 23-site We Promise network: Akron, Newark and 21 cities in three launch waves.">
  <p class="eyebrow">National expansion</p>
  <h1>From one school to 23</h1>
  <Draft
    updated="14 Nov 2026"
    note="City figures are rounded estimates from the Census Bureau's ACS 2019-2023 five-year data and must be verified on data.census.gov before any pitch."
  />

  <p class="page-intro">
    Twenty-three schools, a nod to LeBron's number. Akron (the original I Promise School) and Newark (our
    pilot) are sites 1 and 2. The other 21 are cities where large Black populations meet high child poverty,
    the students the Akron model was built for.
  </p>

  <div class="stats">
    <div class="stat"><div class="num">23</div><div class="lbl">schools in the network</div></div>
    <div class="stat"><div class="num">17</div><div class="lbl">states</div></div>
    <div class="stat"><div class="num">3 waves</div><div class="lbl">of seven cities after Newark</div></div>
    <div class="stat"><div class="num">34</div><div class="lbl">candidate cities scored</div></div>
  </div>

  <section class="block">
    <h2>How cities were chosen</h2>
    <ul class="prose">
      <li><strong>Need score (0 to 100)</strong> across 34 candidate cities: 40% child poverty rate, 35% Black share of residents, 25% size of the Black population (log scale, so big cities count more but do not swamp small, very high-need ones).</li>
      <li><strong>Spread rule:</strong> at most two new cities per state and no second New Jersey city, so the 23 sites span 17 states.</li>
      <li><strong>Strategic picks:</strong> Chicago, Miami Gardens and Los Angeles, for scale and LeBron's ties (Heat, Lakers), even though their citywide scores rank lower.</li>
    </ul>
  </section>

  <section class="block">
    <h2>Launch waves</h2>
    <div class="cards">
      {waves.map((w) => (
        <div class="card wave">
          <h3>{w.name} <span class="small">{w.when}</span></h3>
          <p>{sites.filter((s) => waveOf(s) === w.name).map((s) => s.city).join(', ')}</p>
          <p class="small">{w.why}</p>
        </div>
      ))}
    </div>
    <p class="prose small">
      Wave dates are placeholders. The budget now assumes Newark opens in fall 2028, and the pitch says waves
      start once Newark has a year of results, so these dates are expected to slip and should move with the
      Newark timeline.
    </p>
  </section>

  <section class="block">
    <h2>The 23 sites</h2>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th class="num">#</th><th>City</th><th>Wave</th><th class="num">Black share</th><th class="num">Black residents</th>
            <th class="num">Child poverty</th><th class="num">Need score</th><th>Anchor district</th><th>Why</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((s) => (
            <tr class:list={{ home: s.rank <= 2 }}>
              <td class="num">{s.rank}</td>
              <td><strong>{s.city}, {s.state}</strong></td>
              <td>{waveOf(s)}</td>
              <td class="num">{s.pct_black === '' ? '–' : `${s.pct_black}%`}</td>
              <td class="num">{s.black_pop === '' ? '–' : Number(s.black_pop).toLocaleString('en-US')}</td>
              <td class="num">{s.child_poverty_pct === '' ? '–' : `${s.child_poverty_pct}%`}</td>
              <td class="num">{num(s.need_score)}</td>
              <td>{s.district}</td>
              <td>{s.rationale}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small">
      Black share is the share of city residents who are Black. Child poverty is for all children under 18 in
      the city, not Black children alone; Black child poverty is higher in nearly every city on the list.
      Akron is left blank because it is the existing flagship, not a candidate.{' '}
      <a href={docs.sitesCsv} download>Download the data (CSV)</a>.
    </p>
  </section>

  <section class="block">
    <h2>Alternates, next in line</h2>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>City</th><th class="num">Black share</th><th class="num">Child poverty</th><th class="num">Need score</th><th>Why not in the 23</th></tr></thead>
        <tbody>{alternates.map(([c, b, p, n, w]) => <tr><td>{c}</td><td class="num">{b}</td><td class="num">{p}</td><td class="num">{n}</td><td>{w}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <h2>Data to pull before the pitch</h2>
    <ol class="prose">
      <li>Verify every row against ACS 2019 to 2023 (tables DP05 and S1701) on data.census.gov, and add Black child poverty (table B17020B).</li>
      <li>Add district four-year graduation rates and chronic absenteeism from each state's report card and NCES.</li>
      <li>Map existing LeBron James Family Foundation, NBA team and HBCU partners in each city.</li>
      <li>Note district versus charter route for each city (New Orleans, for example, is all charter).</li>
    </ol>
    <p class="small">
      Sources: <a href="https://data.census.gov/">U.S. Census Bureau, ACS 2019-2023</a>;{' '}
      <a href="https://nces.ed.gov/ccd/">NCES Common Core of Data</a>; <a href="https://ipromise.school/">I Promise School, Akron</a>.
    </p>
  </section>
</Base>

<style>
  .wave { border-top: 5px solid var(--gold); }
  .wave h3 .small { font-weight: 500; }
  tr.home td { background: #fff1cf !important; }
  table.data { font-size: 0.86rem; }
</style>
