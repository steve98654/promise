---
import Base from '../layouts/Base.astro';
import { logos } from '../data/logos';
---

<Base title="Logo concepts · Promise Newark" description="Early logo concepts for the Newark Promise school effort.">
  <h1>Logo concepts</h1>
  <p class="intro">
    Four early directions. Each one says the same thing a different way: LeBron is the GOAT for what
    he did for kids in Akron, and we want to help that promise reach Newark and then the rest of the
    country. None of them use the "I Promise" or LeBron James Family Foundation marks, which belong
    to the foundation.
  </p>

  <div class="grid">
    {logos.map((logo, i) => (
      <article class="card">
        <div class="art">
          <img src={`/logos/${logo.file}`} alt={`${logo.name} logo concept`} width="600" height="480" loading={i < 2 ? 'eager' : 'lazy'} />
        </div>
        <div class="body">
          <p class="num">Concept {i + 1}</p>
          <h2>{logo.name}</h2>
          <p>{logo.idea}</p>
          <p class="best"><strong>Best for:</strong> {logo.bestFor}</p>
          <a href={`/logos/${logo.file}`} download>Download SVG</a>
        </div>
      </article>
    ))}
  </div>

  <section class="palette">
    <h2>Shared palette</h2>
    <ul>
      <li><span style="background:#12233F"></span>Navy #12233F</li>
      <li><span style="background:#F5B82E"></span>Gold #F5B82E</li>
      <li><span style="background:#B23A2B"></span>Brick #B23A2B</li>
      <li><span style="background:#FFF7E8;border:1px solid #ccc"></span>Cream #FFF7E8</li>
    </ul>
  </section>
</Base>

<style>
  .intro { max-width: 760px; color: var(--muted); font-size: 1.05rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 24px; margin-top: 28px; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
  .art { background: var(--cream); border-bottom: 1px solid var(--border); }
  .art img { display: block; width: 100%; height: auto; }
  .body { padding: 18px 20px 22px; }
  .body h2 { margin: 2px 0 8px; font-size: 1.35rem; }
  .num { margin: 0; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; font-weight: 700; color: var(--brick); }
  .best { color: var(--muted); }
  .palette { margin-top: 40px; }
  .palette ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 18px; }
  .palette li { display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; }
  .palette span { width: 28px; height: 28px; border-radius: 6px; display: inline-block; }
</style>
